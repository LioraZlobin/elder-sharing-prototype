@using System
@using System.Linq
@using ElderSharingPrototype.Models.Health
@{
    ViewData["Title"] = "תור וידיאו/טלפוני עם רופא (דמו)";

    // הקונטרולר אמור לשים פה רשימת תורים עתידיים מה-DB:
    // ViewBag.Upcoming = List<AppointmentRequestEntity>
    var upcoming = (ViewBag.Upcoming as System.Collections.Generic.List<AppointmentRequestEntity>)
                   ?? new System.Collections.Generic.List<AppointmentRequestEntity>();
}

<div class="container py-4" style="max-width: 900px;">
    <h1 class="mb-3">תור וידיאו / טלפוני עם רופא (דמו)</h1>

    <div class="alert alert-info" style="font-size:18px;">
        כאן מזמינים תור. הווידיאו <strong>לא</strong> מופיע בזמן הזמנה —
        הוא מופיע רק לאחר לחיצה על <strong>“התחל תור”</strong> בתורים העתידיים.
    </div>
    <div id="teleVisitReminderBox" class="alert alert-warning" style="display:none; font-size:18px; font-weight:700;">
    </div>

    <!-- ✅ כרטיס זימון תור -->
    <div class="card p-3 shadow-sm mb-4" style="border-radius:16px;">
        <h2 class="h5 mb-3">זימון תור חדש</h2>

        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">סוג ביקור</label>
                <select class="form-select" id="visitType">
                    <option value="video" selected>וידיאו</option>
                    <option value="phone">טלפוני</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">תאריך ושעה</label>
                <input id="visitDateTime"
                       type="datetime-local"
                       class="form-control"
                       aria-label="בחרי תאריך ושעה" />
                <div class="form-text">
                    בחרי תאריך ושעה מהתיבה (בלי להקליד).
                </div>
            </div>

            <div class="col-12">
                <label class="form-label">סיבה לפנייה</label>
                <textarea id="visitReason" class="form-control" rows="3"
                          placeholder="למשל: כאבי ראש, בדיקה שגרתית..."></textarea>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
                <button id="btnSchedule"
                        type="button"
                        class="btn btn-success btn-lg"
                        onclick="scheduleTeleVisit()">
                    ✅ הזמן תור (דמו)
                </button>

                <button type="button"
                        class="btn btn-outline-secondary btn-lg"
                        onclick="clearForm()">
                    נקה טופס
                </button>
            </div>

            <div id="scheduleStatus" class="alert alert-warning mt-3" style="display:none;"></div>
        </div>
    </div>

    <!-- ✅ תורים עתידיים -->
    <div class="card p-3 shadow-sm" style="border-radius:16px;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h2 class="h5 mb-0">תורים עתידיים שהוזמנו</h2>
            <div class="text-muted" style="font-size:14px;">
                
            </div>
        </div>

        <hr />

        @if (!upcoming.Any())
        {
            <div class="text-muted" style="font-size:18px;">אין תורים עתידיים.</div>
        }
        else
        {
            <div class="list-group">
                @foreach (var a in upcoming.OrderBy(x => x.PreferredDate).ThenBy(x => x.PreferredTime))
                {
                    var visitType = (a.Notes ?? "").Trim().ToLowerInvariant();
                    bool isVideo = visitType.Contains("video") || visitType.Contains("ויד");

                    var preferredDateText = a.PreferredDate;
                    if (DateTime.TryParse(a.PreferredDate, out var parsedDate))
                    {
                        preferredDateText = parsedDate.ToString("dd/MM/yyyy");
                    }

                    var appointmentDateTimeRaw = $"{a.PreferredDate}T{a.PreferredTime}";

                    <div id="appointmentCard_@a.Id" class="list-group-item" style="border-radius:12px; margin-bottom:10px;">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div>
                                <div style="font-size:18px; font-weight:800;">
                                    @(isVideo ? "🎥 תור וידיאו" : "📞 תור טלפוני")
                                </div>

                                <div class="text-muted" style="font-size:16px;">
                                    תאריך/שעה: <strong>@preferredDateText</strong> @a.PreferredTime
                                </div>

                                <div class="text-muted appointment-time-status"
                                     id="timeStatus_@a.Id"
                                     data-appointment-id="@a.Id"
                                     data-appointment-datetime="@appointmentDateTimeRaw"
                                     style="font-size:14px; margin-top:6px;">
                                </div>

                                @if (!string.IsNullOrWhiteSpace(a.Reason))
                                {
                                    <div style="font-size:16px;">סיבה: @a.Reason</div>
                                }
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button"
                                        class="btn btn-primary start-appointment-btn"
                                        data-appointment-id="@a.Id"
                                        data-appointment-datetime="@appointmentDateTimeRaw"
                                        data-is-video="@(isVideo.ToString().ToLower())"
                                        onclick="startAppointment('@a.Id', @(isVideo.ToString().ToLower()))">
                                    התחל תור
                                </button>

                                <form method="post" action="/Health/CancelTeleVisit" style="display:inline;">
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <button type="submit" class="btn btn-outline-danger">
                                        בטל תור
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div id="apptStatus_@a.Id" class="alert alert-warning mt-3" style="display:none;"></div>

                        <div id="videoBox_@a.Id" class="mt-3" style="display:none;">
                            <div class="border rounded p-3" style="border-radius:16px;">
                                <strong>תצוגה עצמית (מצלמה+מיקרופון):</strong>

                                <div class="mt-3" style="border-radius:12px; overflow:hidden; background:#000;">
                                    <video id="video_@a.Id"
                                           autoplay playsinline muted
                                           style="width:100%; max-height:420px; display:block;">
                                    </video>
                                </div>

                                <div class="d-flex gap-2 flex-wrap mt-3">
                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            onclick="finishAppointment('@a.Id')">
                                        סיים תור
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="mt-4">
        <a class="btn btn-outline-secondary" href="/Prototype/Services">חזרה לשירותים</a>
    </div>
</div>

@section Scripts {
    <script>
        function showScheduleStatus(msg, type) {
            const box = document.getElementById('scheduleStatus');
            box.style.display = 'block';
            box.className = 'alert ' + (type === 'ok' ? 'alert-success' : 'alert-warning') + ' mt-3';
            box.innerText = msg;
        }

        function hideScheduleStatus() {
            const box = document.getElementById('scheduleStatus');
            box.style.display = 'none';
            box.innerText = '';
        }

        function clearForm() {
            document.getElementById('visitType').value = 'video';
            document.getElementById('visitDateTime').value = '';
            document.getElementById('visitReason').value = '';
            hideScheduleStatus();
        }

        function getFormData() {
            const type = (document.getElementById('visitType').value || '').trim();
            const dt = (document.getElementById('visitDateTime').value || '').trim();
            const reason = (document.getElementById('visitReason').value || '').trim();
            return { type, dt, reason };
        }

        function getIsraelNowDateTimeString() {
            const now = new Date();
            const parts = new Intl.DateTimeFormat('sv-SE', {
                timeZone: 'Asia/Jerusalem',
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                hourCycle: 'h23'
            }).formatToParts(now);

            const map = {};
            parts.forEach(p => {
                if (p.type !== "literal") map[p.type] = p.value;
            });

            return `${map.year}-${map.month}-${map.day}T${map.hour}:${map.minute}`;
        }

        function parseDateTimeString(dateTimeStr) {
            if (!dateTimeStr || !dateTimeStr.includes("T")) return null;

            const [datePart, timePart] = dateTimeStr.split("T");
            const [year, month, day] = datePart.split("-").map(Number);
            const [hour, minute] = timePart.split(":").map(Number);

            return new Date(year, month - 1, day, hour, minute, 0, 0);
        }

        function applyMinDateTime() {
            const input = document.getElementById("visitDateTime");
            if (!input) return;
            input.min = getIsraelNowDateTimeString();
        }

        async function scheduleTeleVisit() {
            const { type, dt, reason } = getFormData();

            if (!dt) {
                showScheduleStatus("נא לבחור תאריך ושעה להזמנת התור (דמו).", "err");
                return;
            }

            const nowIsrael = getIsraelNowDateTimeString();
            if (dt < nowIsrael) {
                showScheduleStatus("לא ניתן לבחור תאריך או שעה שכבר עברו.", "err");
                return;
            }

            const parts = dt.split("T");
            const date = parts[0] || "";
            const time = parts[1] || "";

            try {
                const resp = await fetch("/Health/ScheduleTeleVisit", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        visitType: type,
                        preferredDate: date,
                        preferredTime: time,
                        reason: reason
                    })
                });

                const data = await resp.json();

                if (!data || !data.ok) {
                    throw new Error((data && data.message) ? data.message : "שגיאה בהזמנת התור");
                }

                showScheduleStatus("✅ התור הוזמן בהצלחה (דמו).", "ok");
                setTimeout(() => location.reload(), 700);

            } catch (e) {
                console.error(e);
                showScheduleStatus(e.message || "לא הצלחנו להזמין את התור כרגע. נסי שוב. (דמו)", "err");
            }
        }

        const streams = {};
        const startedAppointments = new Set();
        const remindedAppointments = new Set();

        function setApptStatus(appointmentId, msg, type) {
            const box = document.getElementById("apptStatus_" + appointmentId);
            if (!box) return;
            box.style.display = "block";
            box.className = "alert " + (type === "ok" ? "alert-success" : "alert-warning") + " mt-3";
            box.innerText = msg;
        }

        function hideApptStatus(appointmentId) {
            const box = document.getElementById("apptStatus_" + appointmentId);
            if (!box) return;
            box.style.display = "none";
            box.innerText = "";
        }

        function getAppointmentState(appointmentDateTimeStr, isStarted) {
            const nowStr = getIsraelNowDateTimeString();
            const nowDate = parseDateTimeString(nowStr);
            const apptDate = parseDateTimeString(appointmentDateTimeStr);

            if (!nowDate || !apptDate) {
                return { state: "unknown", diffMinutes: 0 };
            }

            const diffMs = nowDate - apptDate;
            const diffMinutes = Math.floor(diffMs / 60000);

            if (isStarted) {
                return { state: "started", diffMinutes };
            }

            if (diffMs < 0) {
                return { state: "future", diffMinutes };
            }

            if (diffMinutes <= 5) {
                return { state: "due", diffMinutes };
            }

            return { state: "late-cancelled", diffMinutes };
        }

        async function startAppointment(appointmentId, isVideo) {
            hideApptStatus(appointmentId);

            const btn = document.querySelector(`[data-appointment-id='${appointmentId}']`);
            const appointmentDateTime = btn?.getAttribute("data-appointment-datetime") || "";

            const stateInfo = getAppointmentState(appointmentDateTime, startedAppointments.has(appointmentId));

            if (stateInfo.state === "future") {
                setApptStatus(appointmentId, "עדיין לא הגיע הזמן לתור הזה.", "err");
                return;
            }

            if (stateInfo.state === "late-cancelled") {
                setApptStatus(appointmentId, "איחור של מעל 5 דקות — התור בוטל.", "err");
                return;
            }

            startedAppointments.add(appointmentId);

            if (!isVideo) {
                setApptStatus(appointmentId, "📞 התור הטלפוני התחיל (דמו).", "ok");
                refreshAppointmentButtons();
                return;
            }

            const box = document.getElementById("videoBox_" + appointmentId);
            const video = document.getElementById("video_" + appointmentId);

            if (!box || !video) return;

            box.style.display = "block";

            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                streams[appointmentId] = stream;
                video.srcObject = stream;
                await video.play();

                setApptStatus(appointmentId, "🎥 התור בווידיאו התחיל (דמו).", "ok");
                refreshAppointmentButtons();
            } catch (err) {
                console.error(err);
                startedAppointments.delete(appointmentId);
                setApptStatus(appointmentId, "לא הצלחנו להפעיל מצלמה/מיקרופון. בדקי הרשאות בדפדפן ונסי שוב.", "err");
                box.style.display = "none";
                refreshAppointmentButtons();
            }
        }

        async function finishAppointment(appointmentId) {
            const stream = streams[appointmentId];
            if (stream) {
                stream.getTracks().forEach(t => t.stop());
                delete streams[appointmentId];
            }

            const video = document.getElementById("video_" + appointmentId);
            if (video) video.srcObject = null;

            const box = document.getElementById("videoBox_" + appointmentId);
            if (box) box.style.display = "none";

            try {
                const resp = await fetch("/Health/FinishTeleVisit", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: "id=" + encodeURIComponent(appointmentId)
                });

                const data = await resp.json();
                if (!data || !data.ok) {
                    throw new Error((data && data.message) ? data.message : "שגיאה בסיום התור");
                }

                const card = document.getElementById("appointmentCard_" + appointmentId);
                if (card) {
                    card.remove();
                }
            } catch (e) {
                console.error(e);
                setApptStatus(appointmentId, "לא הצלחנו לסיים את התור כרגע. נסי שוב.", "err");
            }
        }

        function refreshAppointmentButtons() {
            const buttons = document.querySelectorAll(".start-appointment-btn");
            const statuses = document.querySelectorAll(".appointment-time-status");
            const reminderBox = document.getElementById("teleVisitReminderBox");

            let activeReminderMessage = "";

            buttons.forEach(btn => {
                const appointmentId = btn.getAttribute("data-appointment-id");
                const appointmentDateTime = btn.getAttribute("data-appointment-datetime") || "";
                const isStarted = startedAppointments.has(appointmentId);
                const stateInfo = getAppointmentState(appointmentDateTime, isStarted);

                if (stateInfo.state === "future") {
                    btn.disabled = true;
                    btn.classList.remove("btn-primary", "btn-secondary", "btn-danger");
                    btn.classList.add("btn-secondary");
                }
                else if (stateInfo.state === "due") {
                    btn.disabled = false;
                    btn.classList.remove("btn-primary", "btn-secondary", "btn-danger");
                    btn.classList.add("btn-primary");

                    if (!remindedAppointments.has(appointmentId)) {
                        remindedAppointments.add(appointmentId);
                    }

                    if (!activeReminderMessage) {
                        activeReminderMessage = "הגיע הזמן לתור שלך. אפשר להתחיל עכשיו.";
                    }
                }
                else if (stateInfo.state === "late-cancelled") {
                    btn.disabled = true;
                    btn.classList.remove("btn-primary", "btn-secondary");
                    btn.classList.add("btn-danger");
                }
                else if (stateInfo.state === "started") {
                    btn.disabled = true;
                    btn.classList.remove("btn-primary", "btn-secondary", "btn-danger");
                    btn.classList.add("btn-secondary");
                }
            });

            statuses.forEach(el => {
                const appointmentId = el.getAttribute("data-appointment-id");
                const appointmentDateTime = el.getAttribute("data-appointment-datetime") || "";
                const isStarted = startedAppointments.has(appointmentId);
                const stateInfo = getAppointmentState(appointmentDateTime, isStarted);

                if (stateInfo.state === "future") {
                    el.innerText = "עדיין לא הגיע הזמן לתור.";
                    el.style.color = "#b45309";
                    el.style.fontWeight = "700";
                }
                else if (stateInfo.state === "due") {
                    el.innerText = "הגיע הזמן לתור.";
                    el.style.color = "#15803d";
                    el.style.fontWeight = "700";
                }
                else if (stateInfo.state === "late-cancelled") {
                    el.innerText = "איחור של מעל 5 דקות — התור בוטל.";
                    el.style.color = "#b91c1c";
                    el.style.fontWeight = "700";
                }
                else if (stateInfo.state === "started") {
                    el.innerText = "התור התחיל.";
                    el.style.color = "#2563eb";
                    el.style.fontWeight = "700";
                }
            });

            if (reminderBox) {
                if (activeReminderMessage) {
                    reminderBox.style.display = "block";
                    reminderBox.innerText = activeReminderMessage;
                } else {
                    reminderBox.style.display = "none";
                    reminderBox.innerText = "";
                }
            }
        }

        applyMinDateTime();
        refreshAppointmentButtons();
        setInterval(refreshAppointmentButtons, 30000);
    </script>
}
