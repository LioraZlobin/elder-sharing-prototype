@using ElderSharingPrototype.Models.Health
@{
    ViewData["Title"] = "זימון תור לרופא";
    var requests = ViewBag.Requests as List<AppointmentRequest> ?? new List<AppointmentRequest>();

    var areas = new List<string>
    {
        "רפואת משפחה", "עור", "אא\"ג", "אורתופדיה", "עיניים", "קרדיולוגיה", "אנדוקרינולוגיה", "אחר"
    };
}

<div class="container py-4" style="max-width: 900px;">
    <h1 class="mb-3">זימון תור לרופא</h1>


    @if (TempData["AppointmentOk"] != null)
    {
        <div class="alert alert-success" style="font-size:18px;">
            @TempData["AppointmentOk"]
        </div>
    }

    <form method="post" action="/Health/AddAppointment" class="card p-3 mb-4">
        <h2 class="h5 mb-3">בקשת תור</h2>

        <div class="row g-3">

            <div class="col-12 col-md-6">
                <label class="form-label" style="font-size:18px;">תחום טיפול</label>
                <select name="treatmentArea" class="form-select form-select-lg">
                    <option value="">בחר/י</option>
                    @foreach (var a in areas)
                    {
                        <option value="@a">@a</option>
                    }
                </select>
                @if (TempData["AppointmentTreatmentAreaError"] != null)
                {
                    <span class="text-danger d-block mt-1">@TempData["AppointmentTreatmentAreaError"]</span>
                }
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label" style="font-size:18px;">סיבה לפנייה (אופציונלי)</label>
                <input name="reason" class="form-control form-control-lg" placeholder="למשל: כאבי ראש, בדיקה שגרתית..." />
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label" style="font-size:18px;">תאריך מועדף</label>
                <input id="preferredDate"
                       name="preferredDate"
                       type="date"
                       class="form-control form-control-lg" />
                @if (TempData["AppointmentPreferredDateError"] != null)
                {
                    <span class="text-danger d-block mt-1">@TempData["AppointmentPreferredDateError"]</span>
                }
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label" style="font-size:18px;">שעה מועדפת</label>
                <input id="preferredTime"
                       name="preferredTime"
                       type="time"
                       class="form-control form-control-lg" />
                @if (TempData["AppointmentPreferredTimeError"] != null)
                {
                    <span class="text-danger d-block mt-1">@TempData["AppointmentPreferredTimeError"]</span>
                }
            </div>

            <div class="col-12">
                <label class="form-label" style="font-size:18px;">הערות (אופציונלי)</label>
                <input name="notes" class="form-control form-control-lg" placeholder="למשל: עדיף בבוקר / דחוף..." />
            </div>
        </div>

        <button class="btn btn-primary btn-lg mt-3" type="submit">שלח בקשה</button>
    </form>

    <h2 class="h4 mb-2">הבקשות שלי</h2>

    @if (!requests.Any())
    {
        <div class="text-muted" style="font-size:18px;">אין עדיין בקשות.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var r in requests)
            {
                var preferredDateText = r.PreferredDate;
                if (DateTime.TryParse(r.PreferredDate, out var parsedPreferredDate))
                {
                    preferredDateText = parsedPreferredDate.ToString("dd/MM/yyyy");
                }

                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div style="font-size:18px;">
                        <strong>@r.TreatmentArea</strong>
                        @if (!string.IsNullOrWhiteSpace(r.Reason))
                        {
                            <span> • @r.Reason</span>
                        }

                        <div class="text-muted">
                            @preferredDateText @r.PreferredTime
                            • נוצר: @r.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>

                        @if (!string.IsNullOrWhiteSpace(r.Notes))
                        {
                            <div class="text-muted">@r.Notes</div>
                        }
                    </div>

                    <form method="post" action="/Health/DeleteAppointment" class="m-0">
                        <input type="hidden" name="id" value="@r.Id" />
                        <button class="btn btn-outline-danger">מחק</button>
                    </form>
                </div>
            }
        </div>
    }

    <div class="mt-4">
        <a class="btn btn-link" href="/Prototype/Services">חזרה לשירותים</a>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const dateInput = document.getElementById("preferredDate");
            const timeInput = document.getElementById("preferredTime");

            if (!dateInput || !timeInput) return;

            function getIsraelNowParts() {
                const now = new Date();
                const parts = new Intl.DateTimeFormat('sv-SE', {
                    timeZone: 'Asia/Jerusalem',
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit',
                    hourCycle: 'h23'
                }).formatToParts(now);

                const map = {};
                parts.forEach(p => {
                    if (p.type !== "literal") map[p.type] = p.value;
                });

                return {
                    date: `${map.year}-${map.month}-${map.day}`,
                    time: `${map.hour}:${map.minute}`
                };
            }

            function applyMinValues() {
                const israelNow = getIsraelNowParts();
                dateInput.min = israelNow.date;

                if (dateInput.value === israelNow.date) {
                    timeInput.min = israelNow.time;
                } else {
                    timeInput.removeAttribute("min");
                }
            }

            applyMinValues();
            dateInput.addEventListener("change", applyMinValues);
        })();
    </script>
}